# ===== Kasir Bot — salin jadi .env lalu isi semua nilai =====
# CATATAN: file ini HANYA untuk infrastruktur (n8n + database internal + poller).
# Secret lain (OpenRouter key, spreadsheet ID, folder Drive ID) diisi di dalam
# n8n pada node "Config" workflow — atau via `node sync-creds.js inject`
# dengan creds.local.json. Lihat README bagian "Setup".

# --- Telegram (untuk container tg-poller) ---
# Token dari @BotFather. SAMA dengan bot_token di creds.local.json / Config.
TELEGRAM_BOT_TOKEN=GANTI_TOKEN_BOT

# --- PostgreSQL (internal n8n saja, bukan data kasir) ---
# Generate password acak, mis: openssl rand -hex 16
POSTGRES_USER=n8n
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT
POSTGRES_DB=n8n

# --- n8n / timezone bot ---
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
